{
  "name": "teslaterm",
  "version": "0.1.0",
  "scripts": {
    "tsc": "tsc --build --incremental",
    "start": "npm run tsc && electron .",
    "package-windows": "npm run tsc && electron-builder --windows --dir",
    "package-linux": "npm run tsc && electron-builder --linux --dir"
  },
  "main": "js/main/main_electron.js",
  "dependencies": {
    "@headless-tree/core": "^1.6.3",
    "@headless-tree/react": "^1.6.3",
    "@types/webmidi": "^2.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "basic-ftp": "^5.1.0",
    "bootstrap": "^5.3.8",
    "classnames": "^2.5.1",
    "eslint": "^10.0.0",
    "ini": "^6.0.0",
    "jspack": "0.0.4",
    "jszip": "^3.10.1",
    "justgage": "=1.7.0",
    "midi-file": "^1.2.4",
    "npm-check-updates": "^19.3.2",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.4",
    "react-draggable": "^4.5.0",
    "react-range-slider-input": "^3.3.2",
    "react-zoom-pan-pinch": "^3.7.0",
    "rtpmidi": "^1.0.0",
    "serialport": "13.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/ini": "^4.1.1",
    "@types/w2ui": "^1.4.37",
    "css-loader": "^7.1.3",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "npm": "^11.9.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "appId": "teslaterm",
    "win": {
      "artifactName": "electron/${productName}-windows.${ext}"
    },
    "linux": {
      "artifactName": "electron/${productName}-linux.${ext}"
    },
    "asarUnpack": [
      "js/main/connection/flightrecorder/FlightRecordingWorker.js"
    ]
  }
}
