{
  "include": ["js/**/*.ts", "js/**/*.tsx"],
  "compilerOptions": {
    "typeRoots": [
      "node_modules/@types",
      "js/types"
    ],
    "module": "CommonJS",
    "target": "es2021",
    "sourceMap": true,
    "lib": [
      "ES2021"
    ],
    "esModuleInterop": true,
    "jsx": "react-jsx",
    // "Workaround for broken d.ts in react-range-slider-input"
    "skipLibCheck": true,
    "strict": false
  }
}
