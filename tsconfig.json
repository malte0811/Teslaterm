{
  "include": ["js/**/*.ts", "js/**/*.tsx"],
  "compilerOptions": {
    "typeRoots": [
      "node_modules/@types",
      "js/types"
    ],
    "module": "commonjs",
    "target": "es2021",
    "sourceMap": true,
    "lib": [
      "ES2021"
    ],
    "esModuleInterop": true,
    "jsx": "react-jsx"
  }
}
